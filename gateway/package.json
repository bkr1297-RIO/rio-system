{
  "name": "rio-governance-gateway",
  "version": "2.9.0",
  "description": "RIO Governance Gateway \u2014 Governed AI Execution Runtime",
  "license": "MIT",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/gateway.test.mjs",
    "test:c2c": "node --test tests/office-integrity-validator.test.mjs tests/office-integrity-execution-precheck.test.mjs",
    "test:spgm": "node --test tests/spgm-intake.test.mjs tests/spgm-schema.test.mjs tests/spgm-route.test.mjs tests/spgm-receipt-event.test.mjs tests/spgm-policy-context.test.mjs tests/spgm-policy-adapter.test.mjs tests/spgm-policy-bridge.test.mjs tests/spgm-policy-engine-integration.test.mjs",
    "test:spgm:policy-review": "node --test tests/spgm-policy-review.test.mjs",
    "test:spgm:govern": "node --test tests/spgm-govern-request.test.mjs tests/spgm-govern-route.test.mjs",
    "test:spgm:openapi": "node --test tests/openapi-spgm.test.mjs",
    "test:prime": "node --test tests/prime-runtime-bridge.test.mjs tests/prime-authenticated-sandbox.test.mjs tests/prime-live-gateway-wiring.test.mjs tests/prime-workspace-concurrency.test.mjs tests/prime-workspace-crash-recovery.test.mjs tests/prime-receipt-durability.test.mjs",
    "test:execution-binding": "node --test tests/execution-binding-repair.test.mjs",
    "field": "node local-field/cli.mjs",
    "test:local-field": "node --test tests/local-field*.test.mjs",
    "field:acceptance": "node scripts/run-local-field-acceptance.mjs",
    "field:bilateral-acceptance": "node scripts/run-local-field-bilateral-acceptance.mjs",
    "test:open-arrow": "node --test tests/open-arrow/*.test.mjs",
    "field:open-arrow-acceptance": "node scripts/run-open-arrow-acceptance.mjs",
    "test:projection": "node --test tests/projection-runtime/*.test.mjs",
    "field:projection-acceptance": "node scripts/run-projection-acceptance.mjs",
    "test:si-specimen": "node --test tests/si-specimen/*.test.mjs",
    "field:si-specimen": "node scripts/run-si-specimen-001.mjs",
    "field:simulation": "node scripts/run-si-specimen-001.mjs --simulation",
    "test:ccm": "node --test tests/ccm-001/*.test.mjs",
    "field:ccm": "node scripts/run-ccm-001.mjs",
    "test:waist": "node --test tests/constitutional-waist/*.test.mjs",
    "field:waist": "node scripts/run-constitutional-waist.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pg": "^8.20.0",
    "tweetnacl": "^1.0.3",
    "uuid": "^10.0.0",
    "nodemailer": "^6.9.0",
    "twilio": "^5.0.0"
  }
}
