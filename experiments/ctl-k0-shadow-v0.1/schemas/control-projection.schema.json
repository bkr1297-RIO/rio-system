{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.local/schemas/rio.k0-control-projection-0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evaluationRef", "policyDigest", "mode", "covered", "proposedControl", "firedPredicates", "unresolvedPredicates", "telemetryComplete", "effectVector"],
  "properties": {
    "schemaVersion": { "const": "rio.k0-control-projection/0.1" },
    "evaluationRef": { "type": "string" },
    "policyDigest": { "type": "string" },
    "mode": { "const": "HYPOTHETICAL_ONLY" },
    "covered": { "type": "boolean" },
    "proposedControl": { "enum": ["PASS", "HOLD", "BLOCK", "NOT_COVERED"] },
    "firedPredicates": { "type": "array", "items": { "type": "string" } },
    "unresolvedPredicates": { "type": "array", "items": { "type": "string" } },
    "telemetryComplete": { "type": "boolean" },
    "effectVector": { "$ref": "#/$defs/effectVector" }
  },
  "$defs": {
    "effectVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityEffect", "blockingEffect", "executionEffect", "settlementEffect", "businessMutationEffect", "sourceReadAuditEffect", "rateLimitEffect"],
      "properties": {
        "authorityEffect": { "const": "NONE" },
        "blockingEffect": { "const": "NONE" },
        "executionEffect": { "const": "NONE" },
        "settlementEffect": { "const": "NONE" },
        "businessMutationEffect": { "const": "NONE" },
        "sourceReadAuditEffect": { "const": "PRESENT" },
        "rateLimitEffect": { "const": "PRESENT" }
      }
    }
  }
}
