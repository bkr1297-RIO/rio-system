{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.local/schemas/rio.k0-evaluation-record-0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordKind", "stage", "captureMode", "labels", "gatewayEffect", "requestId", "captureId", "sourceConsistency", "sourceEpochStatus", "sourceCoverage", "inputDigest", "constitutionDigest", "projectionProfileDigest", "humanVisible", "sealedBeforeHumanDisposition", "promotionEligible", "telemetryCompleteness", "projectionRemainder", "request", "report", "evaluationId"],
  "properties": {
    "schemaVersion": { "const": "rio.k0-evaluation-record/0.1" },
    "recordKind": { "const": "K0_EVALUATION" },
    "stage": { "const": "SHADOW" },
    "captureMode": { "const": "POST_FACTO_RETROSPECTIVE" },
    "labels": { "const": ["NON_AUTHORITATIVE_SHADOW", "NOT_FOR_DECISION_USE"] },
    "gatewayEffect": { "const": "NONE" },
    "requestId": { "type": "string", "minLength": 1 },
    "captureId": { "type": "string", "minLength": 64, "maxLength": 64 },
    "sourceConsistency": { "const": "CHAIN_TIP_STABLE_NON_ATOMIC" },
    "sourceEpochStatus": { "type": "string" },
    "sourceCoverage": { "type": "object" },
    "inputDigest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "reportDigest": { "type": ["string", "null"] },
    "semanticProjectionDigest": { "type": ["string", "null"] },
    "constitutionDigest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "verifierDigest": { "type": ["string", "null"] },
    "runnerResultDigest": { "type": ["string", "null"] },
    "projectionProfileDigest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "humanVisible": { "const": false },
    "sealedBeforeHumanDisposition": { "const": false },
    "promotionEligible": { "const": false },
    "telemetryCompleteness": { "type": "object" },
    "projectionRemainder": { "type": "array", "items": { "type": "string" } },
    "request": { "type": "object" },
    "report": { "type": ["object", "null"] },
    "evaluationId": { "type": "string", "minLength": 64, "maxLength": 64 }
  }
}
