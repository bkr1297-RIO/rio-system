{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:one:language:f0.1:crossing:occurrence",
  "x-one-language-profile": "F0.1",
  "x-one-schema-version": "0.1.0",
  "title": "Occurrence",
  "type": "object",
  "required": ["schema_id", "schema_version", "language_profile", "kind", "occurrence_id", "attempt_ref", "external_event_ref", "scope", "occurred_at", "consequence_digest", "observer_refs", "observation_refs", "lawfulness_disposition", "settlement_ref", "succession_effect", "integrity"],
  "properties": {
    "schema_id": {"const": "urn:one:language:f0.1:crossing:occurrence"},
    "schema_version": {"const": "0.1.0"},
    "language_profile": {"const": "F0.1"},
    "kind": {"const": "Occurrence"},
    "occurrence_id": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "attempt_ref": {"anyOf": [{"$ref": "urn:one:language:f0.1:common:object-ref"}, {"type": "null"}]},
    "external_event_ref": {"anyOf": [{"$ref": "urn:one:language:f0.1:common:object-ref"}, {"type": "null"}]},
    "scope": {"enum": ["LOCAL", "EXTERNAL"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "consequence_digest": {"$ref": "urn:one:language:f0.1:common:digest"},
    "observer_refs": {"type": "array", "items": {"$ref": "urn:one:language:f0.1:common:object-ref"}, "minItems": 1, "uniqueItems": true},
    "observation_refs": {"type": "array", "items": {"$ref": "urn:one:language:f0.1:common:object-ref"}, "uniqueItems": true},
    "lawfulness_disposition": {"enum": ["UNEVALUATED", "CONFORMING", "BREACH", "UNSETTLED"]},
    "settlement_ref": {"anyOf": [{"$ref": "urn:one:language:f0.1:common:object-ref"}, {"type": "null"}]},
    "succession_effect": {"const": "NONE"},
    "integrity": {"$ref": "urn:one:language:f0.1:common:integrity-block"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "EXTERNAL"}}},
      "then": {"properties": {"external_event_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"}}}
    }
  ]
}
