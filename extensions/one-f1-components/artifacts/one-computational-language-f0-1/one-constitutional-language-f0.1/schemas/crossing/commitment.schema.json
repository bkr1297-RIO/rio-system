{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:one:language:f0.1:crossing:commitment",
  "x-one-language-profile": "F0.1",
  "x-one-schema-version": "0.1.0",
  "title": "Commitment",
  "type": "object",
  "required": ["schema_id", "schema_version", "language_profile", "kind", "commitment_id", "proposal_ref", "selected_candidate_ref", "evaluation_ref", "authorization_ref", "authority_derivation_ref", "conditions_ref", "subject_ref", "action", "object_ref", "payload_digest", "intended_delta_digest", "purpose", "scope", "dependency_bindings", "evidence_obligation_refs", "return_obligation_ref", "committed_by_ref", "committed_at", "expires_at", "state", "commitment_effect", "execution_effect", "integrity"],
  "properties": {
    "schema_id": {"const": "urn:one:language:f0.1:crossing:commitment"},
    "schema_version": {"const": "0.1.0"},
    "language_profile": {"const": "F0.1"},
    "kind": {"const": "Commitment"},
    "commitment_id": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "proposal_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "selected_candidate_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "evaluation_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "authorization_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "authority_derivation_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "conditions_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "subject_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "action": {"type": "string", "minLength": 1},
    "object_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "payload_digest": {"$ref": "urn:one:language:f0.1:common:digest"},
    "intended_delta_digest": {"$ref": "urn:one:language:f0.1:common:digest"},
    "purpose": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "dependency_bindings": {"type": "array", "items": {"$ref": "urn:one:language:f0.1:common:dependency-binding"}, "minItems": 1},
    "evidence_obligation_refs": {"type": "array", "items": {"$ref": "urn:one:language:f0.1:common:object-ref"}, "minItems": 1, "uniqueItems": true},
    "return_obligation_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "committed_by_ref": {"$ref": "urn:one:language:f0.1:common:object-ref"},
    "committed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["BOUND", "RELEASED", "EXPIRED", "CANCELLED"]},
    "commitment_effect": {"const": "BINDS_INTENDED_CROSSING"},
    "execution_effect": {"const": "NONE"},
    "integrity": {"$ref": "urn:one:language:f0.1:common:integrity-block"}
  },
  "additionalProperties": false
}
